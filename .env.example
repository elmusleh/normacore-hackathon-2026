# CareArm (Team 6) — Environment Configuration Template
# Copy this file to `.env` and fill in your own API keys. Never commit `.env`.

# Required for Claude MCP console agent (src/console_agent.py)
ANTHROPIC_API_KEY=

# Required for bilingual EN/DE speech-to-text (gpt-transcribe) & TTS (tts-1 / tts-1-hd)
OPENAI_API_KEY=

# Safety gate: keep "0" for dry-run rehearsal; set "1" only at the bench with hand on 12 V cutoff
ELROBOT_ALLOW_MOTION=0

# Optional model overrides
# WEB_CONSOLE_MODEL=claude-opus-5-5
# WEB_CONSOLE_STT_MODEL=gpt-transcribe
# WEB_CONSOLE_MODE=plans
